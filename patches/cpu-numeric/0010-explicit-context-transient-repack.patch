+ggml_cgraph * llama_context::build_graph_with_cpu_workspace(const llm_graph_params & params) {
+    auto * gf = model.build_graph(params);
+    if (!gf || !cparams.cpu_transient_repack) return gf;
+    auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend_cpu));
+    using mark_fn = bool (*)(ggml_tensor *);
+    using size_fn = size_t (*)(const ggml_tensor *);
+    auto mark = (mark_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_mark_transient_repack");
+    auto size = (size_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_transient_repack_size");
+    if (!mark || !size) throw std::runtime_error("Explicit transient repack API unavailable");
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        auto * node = ggml_graph_node(gf, i);
+        if (mark(node)) {
+            ++transient_graph_nodes_marked;
+            transient_maximum_requested_bytes = std::max<uint64_t>(transient_maximum_requested_bytes, size(node));
+        }
+    }
+    return gf;
+}
+
+llama_motoai_transient_stats llama_context::get_transient_stats() const {
+    using size_fn = size_t (*)(ggml_backend_t);
+    auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend_cpu));
+    auto size = (size_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_workspace_size");
+    return {transient_graph_nodes_marked, transient_maximum_requested_bytes, size ? size(backend_cpu) : 0};
+}
+
+llama_motoai_transient_stats llama_motoai_get_transient_stats(const llama_context * ctx) {
+    return ctx->get_transient_stats();
 }
 
