+class transient_tensor_traits : public ggml::cpu::tensor_traits {
+    bool work_size(int, const ggml_tensor * op, size_t & size) override {
+        size = ggml_backend_cpu_transient_repack_size(op);
+        return true;
+    }
+    bool compute_forward(ggml_compute_params * params, ggml_tensor * op) override {
+        const auto * original = op->src[0];
+        const size_t offset = GGML_PAD(ggml_nbytes(original), 64);
+        GGML_ASSERT(params->wsize >= ggml_backend_cpu_transient_repack_size(op));
+        auto * traits = (tensor_traits_base *) ggml_repack_get_optimal_repack_type(original);
+        GGML_ASSERT(traits);
+        // Partition complete eight-row groups: disjoint writes and unchanged
+        // original scales/quants. Only stack-local tensor metadata is modified.
+        const int64_t groups = original->ne[1] / 8;
+        const int64_t first = groups * params->ith / params->nth * 8;
+        const int64_t end = groups * (params->ith + 1) / params->nth * 8;
+        if (end > first) {
+            ggml_tensor slice = *original;
+            slice.ne[1] = end - first;
+            slice.nb[2] = slice.nb[1] * slice.ne[1];
+            slice.nb[3] = slice.nb[2];
+            slice.data = (char *) params->wdata + first * original->nb[1];
+            GGML_ASSERT(traits->repack(&slice, (const char *) original->data + first * original->nb[1], ggml_nbytes(&slice)) == 0);
+        }
+        ggml_barrier(params->threadpool);
+        ggml_tensor packed = *original;
+        packed.data = params->wdata;
+        ggml_tensor local_op = *op;
+        local_op.src[0] = &packed;
+        ggml_compute_params local_params = *params;
+        local_params.wdata = (char *) params->wdata + offset;
+        local_params.wsize -= offset;
+        GGML_ASSERT(traits->compute_forward(&local_params, &local_op));
+        return true;
+    }
