+// One shared CPU graph workspace, never a persistent model-weight allocation.
+// Last op-parameter word is private to this experimental CPU MUL_MAT path;
+// precision remains in word0. No global switch or mutation of source metadata.
+static constexpr uint32_t transient_repack_tag = 0x4d545250;
+static bool transient_repack_marked(const ggml_tensor * op) {
+    uint32_t tag = 0;
+    memcpy(&tag, (const char *) op->op_params + GGML_MAX_OP_PARAMS - sizeof(tag), sizeof(tag));
+    return op->op == GGML_OP_MUL_MAT && tag == transient_repack_tag;
+}
+static bool transient_repack_eligible(const ggml_tensor * op) {
+    if (op->op != GGML_OP_MUL_MAT || !ggml_cpu_has_neon() || !ggml_cpu_has_matmul_int8()) return false;
+    const auto * w = op->src[0];
+    const auto * x = op->src[1];
+    if (!w || !x || (w->type != GGML_TYPE_Q4_K && w->type != GGML_TYPE_Q6_K) ||
+        ggml_n_dims(w) != 2 || ggml_n_dims(x) != 2 || !ggml_is_contiguous(w) ||
+        !ggml_is_contiguous(x) || x->type != GGML_TYPE_F32 || op->type != GGML_TYPE_F32 ||
+        w->ne[0] != x->ne[0] || w->ne[0] > 16384 || w->ne[1] > 16384 ||
+        w->ne[0] % QK_K || w->ne[1] % 8 || x->ne[1] < 4 || x->ne[1] > 512 ||
+        ggml_nbytes(w) > 64*1024*1024 || !ggml_repack_get_optimal_repack_type(w)) return false;
+    for (const auto * t : {w, x}) {
+        if (t->buffer && !ggml_backend_buft_is_host(t->buffer->buft)) return false;
+    }
+    const size_t size = GGML_PAD(ggml_nbytes(w), 64) + ggml_row_size(GGML_TYPE_Q8_K, ggml_nelements(x));
+    return size <= 80*1024*1024;
+}
+bool ggml_backend_cpu_mark_transient_repack(ggml_tensor * op) {
+    if (!transient_repack_eligible(op)) return false;
+    memcpy((char *) op->op_params + GGML_MAX_OP_PARAMS - sizeof(transient_repack_tag),
+           &transient_repack_tag, sizeof(transient_repack_tag));
+    return true;
+}
+size_t ggml_backend_cpu_transient_repack_size(const ggml_tensor * op) {
+    if (!transient_repack_marked(op)) return 0;
+    GGML_ASSERT(transient_repack_eligible(op));
+    return GGML_PAD(ggml_nbytes(op->src[0]), 64) + ggml_row_size(GGML_TYPE_Q8_K, ggml_nelements(op->src[1]));
