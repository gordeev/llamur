+int32_t llama_tokenize_with_input_ranges(
+    const struct llama_vocab * vocab, const char * text, int32_t text_len,
+    llama_token * tokens, int32_t n_tokens_max, bool add_special,
+    const struct llama_tokenize_input_range * ranges, int32_t n_ranges) {
+    if (!vocab || !text || text_len < 0 || n_tokens_max < 0 ||
+        (n_tokens_max > 0 && !tokens) || n_ranges < 0 || n_ranges > 4096 || (n_ranges > 0 && !ranges))
+        throw std::invalid_argument("Invalid input-range tokenizer arguments");
+    std::vector<llama_tokenize_input_range> spans;
+    uint64_t end = 0;
+    for (int32_t i = 0; i < n_ranges; ++i) {
+        const auto span = ranges[i];
+        if (!span.length || span.offset < end || uint64_t(span.offset) + span.length > uint64_t(text_len))
+            throw std::invalid_argument("Invalid or overlapping chat input range");
+        end = uint64_t(span.offset) + span.length;
+        spans.push_back(span);
+    }
+    const auto output = vocab->tokenize(std::string(text, text_len), add_special, true, &spans);
+    if (output.size() >= size_t(std::numeric_limits<int32_t>::max())) return std::numeric_limits<int32_t>::min();
+    if (size_t(n_tokens_max) < output.size()) return -int32_t(output.size());
+    std::copy(output.begin(), output.end(), tokens);
+    return int32_t(output.size());
+}
